{
  "name": "safewalk-henrico",
  "private": true,
  "version": "0.1.0",
  "description": "Tracking every promised pedestrian-safety project in Henrico County, Virginia.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "fetch-crashes": "node scripts/fetch-crashes.mjs",
    "fetch-schools": "node scripts/fetch-schools.mjs",
    "fetch-boundary": "node scripts/fetch-boundary.mjs",
    "geocode-projects": "node scripts/geocode-projects.mjs",
    "analyze-corridors": "node scripts/analyze-corridors.mjs",
    "format:check": "prettier --check .",
    "make-sample": "node scripts/make-sample-crashes.mjs",
    "verify:map": "node scripts/verify-map.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.114.0"
  }
}
